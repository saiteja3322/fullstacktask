PORT=5000
NODE_ENV=development

# Database Connection (Neon PostgreSQL or local)
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/mini_erp_db?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_123456789_jwt_secret!
JWT_REFRESH_SECRET=super_secret_refresh_key_987654321_jwt_secret!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
